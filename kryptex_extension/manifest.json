{
  "manifest_version": 3,
  "name": "Kryptex Auto-Restart Monitor",
  "version": "1.0",
  "description": "Automatically monitors profitability and restarts Kryptex when errors occur.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:15000/*",
    "http://localhost:15000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.kryptex.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}